# SoraPlan plan parsing worker — local development settings.
# Copy to .env (gitignored). On Cloud Run OPENAI_API_KEY comes from Secret Manager.
ENV=development
PORT=8001
HOST=0.0.0.0

# Gemini plan parsing (Vertex AI with ADC by default; `gcloud auth application-default login` locally)
GEMINI_PARSER_MODEL=gemini-4-argon
GEMINI_LOCATION=global
# Local only, optional: use a Gemini API key instead of Vertex AI
GEMINI_API_KEY=

# [secret] OpenAI key for furniture background removal
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol

FIREBASE_PROJECT_ID=soraplan
# Local only. Leave empty to use Application Default Credentials.
FIREBASE_CREDENTIALS_PATH=../api/.secrets/serviceAccountKey.json
GCS_BUCKET_NAME=soraplan-assest-dev
