# SoraPlan API User Environment Configuration
ENV=development
PORT=8000
HOST=0.0.0.0

# Firebase / Google Cloud Project
FIREBASE_PROJECT_ID=soraplan
# Web API Key for Identity Toolkit (sign-in with password & token refresh)
FIREBASE_WEB_API_KEY=
# Optional: path to service account json file if not using Application Default Credentials
FIREBASE_CREDENTIALS_PATH=

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
