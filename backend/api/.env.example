# SoraPlan API — local development settings.
# Copy to .env (gitignored). On Cloud Run these come from deploy/deploy.sh
# (plain env vars) and Secret Manager (keys marked [secret]).
ENV=development
PORT=8000
HOST=0.0.0.0

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=soraplan
# [secret] Firebase Web API key, used for Identity Toolkit password sign-in and token refresh
FIREBASE_WEB_API_KEY=
# Local only: service account key. Leave empty to use `gcloud auth application-default login`.
FIREBASE_CREDENTIALS_PATH=.secrets/serviceAccountKey.json
# Firebase UIDs with admin rights (comma-separated)
ADMIN_UIDS=

# Cloud Storage
GCS_BUCKET_NAME=soraplan-assest-dev
GCS_SIGNED_URL_EXPIRATION_SECONDS=86400
# Public-read bucket with the preset furniture catalog (assets/{Style}/...)
CATALOG_BUCKET_NAME=soraplan-catalog

# Plan parsing worker
PLAN_PARSER_WORKER_URL=http://localhost:8001
# Leave empty locally (direct HTTP). Production: projects/soraplan/locations/<region>/queues/plan-parsing
CLOUD_TASKS_QUEUE=
TASKS_INVOKER_SA=
WORKER_REQUIRES_AUTH=false
JOB_STALE_SECONDS=900

# [secret] Meshy image-to-3D
MESHY_API_KEY=

# Allowed browser origins (comma-separated or JSON list). Never "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
